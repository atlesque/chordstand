{
	"ci": {
		"collect": {
			"startServerCommand": "node scripts/serve.mjs",
			"startServerReadyPattern": "Serving",
			"url": ["http://localhost:4173/", "http://localhost:4173/new"],
			"numberOfRuns": 3,
			"settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75 }, "throttlingMethod": "simulate" }
		},
		"assert": {
			"assertions": {
				"categories:performance": ["error", { "minScore": 0.95 }],
				"categories:accessibility": ["error", { "minScore": 0.95 }],
				"categories:best-practices": ["error", { "minScore": 0.95 }],
				"categories:seo": ["error", { "minScore": 0.95 }]
			}
		},
		"upload": { "target": "temporary-public-storage" }
	}
}
